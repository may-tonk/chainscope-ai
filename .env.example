# Configuration template only: no credentials are included.
# All network/database commands load the project root .env; OS env overrides it.
# Preferred provider: Alchemy BNB mainnet, https://bnb-mainnet.g.alchemy.com/v2/<API_KEY>
BSC_RPC_URL=
# This collector uses Transfers API pagination, not eth_getLogs block chunks.
# SQLAlchemy constructs mysql+pymysql URLs from these separate fields.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=chainscope
# Optional: SQD Portal key (Testing or paid plan). Empty uses the public Portal.
SQD_API_KEY=
# Optional: another Portal address. Empty means https://portal.sqd.dev
SQD_PORTAL_URL=

# Local collection Agent (openai-agents + DeepSeek). Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Website account database (PostgreSQL on the development VM). TLS with server
# verification is always used (sslmode=verify-full). Runtime accounts read and
# write; migrator accounts own the tables and only run `alembic -n webapp`.
WEBAPP_DB_HOST=
WEBAPP_DB_PORT=5432
WEBAPP_DB_SSLROOTCERT=
WEBAPP_DB_NAME=chainscope_app
WEBAPP_DB_USER=chainscope_app
WEBAPP_DB_PASSWORD=
WEBAPP_DB_MIGRATOR_USER=chainscope_migrator
WEBAPP_DB_MIGRATOR_PASSWORD=
# Automated tests only; tests recreate tables here and never touch the above.
WEBAPP_TEST_DB_NAME=chainscope_app_test
WEBAPP_TEST_DB_USER=chainscope_test
WEBAPP_TEST_DB_PASSWORD=
WEBAPP_TEST_DB_MIGRATOR_USER=chainscope_test_migrator
WEBAPP_TEST_DB_MIGRATOR_PASSWORD=

# Website server keys: generate with `python python/tools/generate_webapp_keys.py`
# and paste here. Four different 256-bit keys; never reuse demo values.
# Replacing them logs everyone out; bump AUTH_KEY_VERSION when rotating.
AUTH_SESSION_KEY=
AUTH_CSRF_KEY=
AUTH_EMAIL_CODE_KEY=
AUTH_RATE_LIMIT_KEY=
AUTH_KEY_VERSION=1

# Website runtime (defaults shown are used in development when left empty).
# Production requires explicit https origins and hosts, and refuses console mail.
WEBAPP_ENV=development
WEBAPP_ALLOWED_ORIGINS=http://localhost:5173
WEBAPP_ALLOWED_HOSTS=localhost,127.0.0.1
WEBAPP_MAIL_MODE=console
WEBAPP_TRUSTED_PROXIES=
